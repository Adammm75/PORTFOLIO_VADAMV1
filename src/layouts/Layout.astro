---
import '@/styles/global.css'
import '@/styles/typography.css'

import Footer from '@/components/Footer.astro'
import Head from '@/components/Head.astro'
import CommandPalette from '@/components/react/command-palette'
import Cursor from '@/components/react/cursor'
import Navbar from '@/components/react/navbar'
import { SITE } from '@/consts'
import { getAllProjects } from '@/lib/data-utils'
import { cn } from '@/lib/utils'

interface Props {
  title: string
  description?: string
  image?: string
  type?: 'website' | 'article'
  /** Removes the reading-width cap on the main column. */
  isWide?: boolean
}

const { title, description, image, type, isWide = false } = Astro.props

const projects = await getAllProjects()
const paletteProjects = projects.map((project) => ({
  id: project.id,
  name: project.data.name,
  tags: project.data.tags ?? [],
}))
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <Head title={title} description={description} image={image} type={type} />
    <slot name="head" />

    <noscript>
      <style>
        /* Motion components ship their entrance styles inline; without JS
           they would never animate in, so reveal everything up front. */
        [style*='opacity:0'],
        [style*='opacity: 0'] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <script is:inline>
      // Applies the stored theme before first paint to avoid a flash.
      ;(function () {
        try {
          var stored = localStorage.getItem('theme')
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)')
          var isDark = stored ? stored === 'dark' : prefersDark.matches

          document.documentElement.classList.toggle('dark', isDark)

          // Only follow the system while the visitor hasn't picked a theme.
          prefersDark.addEventListener('change', function (event) {
            if (localStorage.getItem('theme')) return
            document.documentElement.classList.toggle('dark', event.matches)
          })
        } catch (error) {
          document.documentElement.classList.add('dark')
        }
      })()
    </script>

    <script is:inline>
      // Marks the document as JS-capable so `[data-reveal]` can start hidden.
      document.documentElement.classList.add('js')
    </script>
  </head>

  <body>
    <a href="#main" class="skip-link">Aller au contenu</a>

    <div class="ambient" aria-hidden="true"></div>
    <div class="gridlines" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>

    <Navbar client:load />
    <CommandPalette projects={paletteProjects} client:idle />
    <Cursor client:idle />

    <main
      id="main"
      class="relative z-10 flex min-h-screen flex-col"
      style="padding-top: var(--nav-height)"
    >
      <div class={cn('w-full flex-1', !isWide && 'shell')}>
        <slot />
      </div>
    </main>

    <Footer />

    <script>
      // Reveals `[data-reveal]` blocks as they enter the viewport.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]')

      if (
        window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
        !('IntersectionObserver' in window)
      ) {
        targets.forEach((node) => node.classList.add('is-visible'))
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return
              entry.target.classList.add('is-visible')
              observer.unobserve(entry.target)
            })
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.05 },
        )

        targets.forEach((node) => observer.observe(node))
      }
    </script>
  </body>
</html>
