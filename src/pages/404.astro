---
import Layout from '@/layouts/Layout.astro'
import { ArrowLeft, FolderOpen } from 'lucide-react'
---

<Layout
  title="Page introuvable"
  description="Cette page n'existe pas ou a été déplacée."
>
  <section
    class="flex min-h-[70vh] flex-col items-center justify-center py-20 text-center"
  >
    <p class="kicker" data-reveal>Erreur 404</p>

    <p
      class="font-display text-gradient mt-6 text-[clamp(5rem,22vw,14rem)] leading-none"
      data-reveal
      style="--reveal-delay:80ms"
      aria-hidden="true"
    >
      404
    </p>

    <h1 class="font-display mt-2 text-3xl sm:text-4xl" data-reveal style="--reveal-delay:160ms">
      Cette page a disparu du dépôt.
    </h1>

    <p
      class="text-muted-foreground mt-4 max-w-md text-balance"
      data-reveal
      style="--reveal-delay:220ms"
    >
      Le lien est peut-être obsolète, ou la page a été renommée. Reprenons depuis
      un endroit connu.
    </p>

    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-3"
      data-reveal
      style="--reveal-delay:300ms"
    >
      <a
        href="/"
        class="bg-primary text-primary-foreground sheen relative inline-flex items-center gap-2 overflow-hidden rounded-full px-6 py-3.5 text-sm font-semibold"
      >
        <ArrowLeft className="size-4" />
        Retour à l'accueil
      </a>
      <a
        href="/projects"
        class="border-border hover:border-accent-line hover:bg-card/60 inline-flex items-center gap-2 rounded-full border px-6 py-3.5 text-sm font-semibold transition-colors"
      >
        <FolderOpen className="size-4" />
        Voir les projets
      </a>
    </div>

    <p
      class="text-muted-foreground mt-8 font-mono text-xs"
      data-reveal
      style="--reveal-delay:360ms"
    >
      Astuce : appuyez sur <kbd class="bg-muted rounded px-1.5 py-0.5">Ctrl</kbd>
      +
      <kbd class="bg-muted rounded px-1.5 py-0.5">K</kbd> pour rechercher.
    </p>
  </section>
</Layout>
