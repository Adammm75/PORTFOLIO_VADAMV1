---
import Section from '@/components/Section.astro'
import ContactForm from '@/components/react/contact-form'
import Expertise from '@/components/react/expertise'
import Hero from '@/components/react/hero'
import Parcours from '@/components/react/parcours'
import ProjectsGrid from '@/components/react/projects-grid'
import Skills from '@/components/react/skills'
import { EXPERTISE_AREAS, SITE, SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects, getProjectCards } from '@/lib/data-utils'
import { ArrowUpRight, Mail, MapPin } from 'lucide-react'

const projects = await getAllProjects()
const featured = await getProjectCards(projects.slice(0, 3))

const linkedin = SOCIAL_LINKS.find((social) => social.label === 'LinkedIn')
---

<Layout title={SITE.title} description={SITE.descriptionPlain}>
  <!-- 00 · Accueil -->
  <section id="accueil" class="scroll-mt-28 pt-10 pb-20 sm:pt-16 sm:pb-28">
    <Hero client:load />
  </section>

  <!-- Stack -->
  <section aria-labelledby="stack-title" class="pb-20 sm:pb-28">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4" data-reveal>
      <h2 id="stack-title" class="kicker">
        Stack technique du quotidien
      </h2>
      <p class="text-muted-foreground hidden text-xs sm:block">
        Survolez pour mettre en pause
      </p>
    </div>
    <div class="bleed">
      <Skills />
    </div>
  </section>

  <div class="hairline" aria-hidden="true"></div>

  <!-- 01 · Expertise -->
  <Section
    id="expertise"
    index="01"
    kicker="Compétences & expertise"
    title="Ce que je sais faire, concrètement."
    lead="Découvrez mes domaines d'expertise et mes compétences techniques organisées par spécialité."
  >
    <Expertise client:load />
  </Section>

  <div class="hairline" aria-hidden="true"></div>

  <!-- 02 · Parcours -->
  <Section
    id="parcours"
    index="02"
    kicker="Mon parcours"
    title="Deux ans en entreprise, cap sur le Master MIAGE."
    lead="Actuellement en alternance après ma Licence CNAM obtenue en septembre 2025, puis entrée en Master MIAGE de septembre 2025 à septembre 2027, spécialisé en Systèmes d'Information et Intelligence des données."
  >
    <Parcours client:load />
  </Section>

  <div class="hairline" aria-hidden="true"></div>

  <!-- 03 · Projets -->
  <Section
    id="projets"
    index="03"
    kicker="Sélection de projets"
    title="Des idées transformées en solutions."
    lead="Un aperçu de mes réalisations les plus récentes en IA, data science, automatisation et développement."
  >
    <ProjectsGrid projects={featured} showFilters={false} client:load />

    <div class="mt-12 flex justify-center" data-reveal>
      <a
        href="/projects"
        data-cursor-label="tout voir"
        class="border-border hover:border-accent-line hover:bg-card/60 group inline-flex items-center gap-2 rounded-full border px-6 py-3.5 text-sm font-semibold transition-colors duration-300"
      >
        Voir les {projects.length} projets
        <ArrowUpRight
          className="size-4 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>
  </Section>

  <div class="hairline" aria-hidden="true"></div>

  <!-- 04 · Contact -->
  <Section
    id="contact"
    index="04"
    kicker="Contact"
    title="Un projet IA ? Parlons-en."
    lead="Vous avez un projet IA ou une opportunité de collaboration ? N'hésitez pas à me contacter."
  >
    <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      <div class="flex flex-col gap-8" data-reveal>
        <div class="panel p-6">
          <h3 class="kicker">Localisation</h3>
          <p class="mt-3 flex items-center gap-2 text-lg">
            <MapPin className="text-primary size-4" />
            {SITE.location}
          </p>
        </div>

        <div class="panel p-6">
          <h3 class="kicker">Écrire directement</h3>
          <a
            href={`mailto:${SITE.email}`}
            class="group mt-3 flex items-center gap-2 text-lg break-all"
          >
            <Mail className="text-primary size-4 shrink-0" />
            <span class="link-underline">{SITE.email}</span>
          </a>
          {
            linkedin && (
              <a
                href={linkedin.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-muted-foreground hover:text-primary link-underline mt-3 inline-flex items-center gap-2 text-sm transition-colors"
              >
                <ArrowUpRight className="size-4" />
                Me contacter sur LinkedIn
              </a>
            )
          }
        </div>

        <div>
          <h3 class="kicker">Domaines d'expertise</h3>
          <ul class="mt-4 space-y-2">
            {
              EXPERTISE_AREAS.map((area, index) => (
                <li
                  data-reveal
                  style={`--reveal-delay:${index * 60}ms`}
                  class="panel panel-hover group flex items-center gap-3 px-4 py-3 text-sm"
                >
                  <span
                    aria-hidden="true"
                    class="bg-primary size-1.5 shrink-0 rounded-full transition-transform duration-300 group-hover:scale-150"
                  />
                  {area}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <ContactForm client:load />
    </div>
  </Section>
</Layout>
