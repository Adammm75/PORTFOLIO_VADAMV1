---
import Breadcrumbs from '@/components/Breadcrumbs.astro'
import TableOfContents from '@/components/TableOfContents.astro'
import { SITE } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllProjects } from '@/lib/data-utils'
import { formatMonth, readingTime } from '@/lib/utils'
import { Image } from 'astro:assets'
import { render } from 'astro:content'
import { ArrowLeft, ArrowRight, ArrowUpRight, Clock, Tag } from 'lucide-react'

export async function getStaticPaths() {
  const projects = await getAllProjects()
  return projects.map((project, index) => ({
    params: { id: project.id },
    props: {
      project,
      previous: projects[index - 1] ?? null,
      next: projects[index + 1] ?? null,
    },
  }))
}

const { project, previous, next } = Astro.props
const { Content, headings } = await render(project)

const { name, description, tags, image, link, startDate, endDate } = project.data

const period = [startDate && formatMonth(startDate), endDate && formatMonth(endDate)]
  .filter(Boolean)
  .join(' — ')

const ogImage = new URL(`/image/${project.id}.png`, Astro.site ?? SITE.href).toString()

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name,
  headline: name,
  description,
  keywords: tags?.join(', ') ?? '',
  datePublished: startDate?.toISOString(),
  dateModified: (endDate ?? startDate)?.toISOString(),
  image: ogImage,
  url: new URL(`/projects/${project.id}/`, Astro.site ?? SITE.href).toString(),
  author: { '@type': 'Person', name: SITE.author, url: SITE.href },
}
---

<Layout title={name} description={description} image={ogImage} type="article" isWide>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(structuredData)}
  />

  <div class="shell py-10 sm:py-14">
    <Breadcrumbs
      items={[
        { href: '/projects', label: 'Projets', icon: 'lucide:folder' },
        { label: name, icon: 'lucide:folder-open' },
      ]}
    />

    <header class="mx-auto max-w-3xl" data-reveal>
      {period && <p class="kicker">{period}</p>}

      <h1 class="font-display mt-4 text-[clamp(2rem,5vw,3.5rem)] leading-[1.05]">
        {name}
      </h1>

      <p class="text-muted-foreground mt-5 text-lg leading-relaxed text-pretty">
        {description}
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-2">
        {
          tags?.map((tag) => (
            <a
              href={`/projects?tag=${encodeURIComponent(tag)}`}
              class="border-border text-muted-foreground hover:border-accent-line hover:text-foreground inline-flex items-center gap-1.5 rounded-full border px-3 py-1.5 font-mono text-[0.68rem] transition-colors"
            >
              <Tag className="size-3" />
              {tag}
            </a>
          ))
        }
      </div>

      <div class="border-border text-muted-foreground mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 border-t pt-6 text-sm">
        <span class="inline-flex items-center gap-1.5">
          <Clock className="size-4" />
          {readingTime(project.body ?? '')}
        </span>
        {
          link && (
            <a
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor-label="code"
              class="text-primary hover:text-foreground link-underline inline-flex items-center gap-1.5 font-medium transition-colors"
            >
              <ArrowUpRight className="size-4" />
              Voir le dépôt du projet
            </a>
          )
        }
      </div>
    </header>

    <figure class="mt-12" data-reveal>
      <Image
        src={image}
        alt={`Aperçu du projet ${name}`}
        widths={[640, 960, 1440]}
        sizes="(min-width: 1280px) 1200px, 100vw"
        format="webp"
        quality={80}
        loading="eager"
        class="border-border max-h-[70vh] w-full rounded-2xl border object-cover"
      />
    </figure>

    <div class="mt-16 grid gap-12 xl:grid-cols-[16rem_minmax(0,1fr)] xl:gap-16">
      <aside
        class="xl:sticky xl:top-28 xl:max-h-[calc(100vh-9rem)] xl:self-start xl:overflow-y-auto xl:pr-2"
      >
        <TableOfContents headings={headings} />
      </aside>

      <article class="prose min-w-0 max-w-3xl">
        <Content />
      </article>
    </div>

    <nav
      aria-label="Projets adjacents"
      class="border-border mt-20 grid gap-4 border-t pt-10 sm:grid-cols-2"
    >
      {
        previous ? (
          <a
            href={`/projects/${previous.id}`}
            class="panel panel-hover group flex flex-col gap-2 p-5"
          >
            <span class="kicker flex items-center gap-2">
              <ArrowLeft className="size-3.5" />
              Projet précédent
            </span>
            <span class="font-display group-hover:text-primary text-lg transition-colors">
              {previous.data.name}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/projects/${next.id}`}
            class="panel panel-hover group flex flex-col items-end gap-2 p-5 text-right sm:col-start-2"
          >
            <span class="kicker flex items-center gap-2">
              Projet suivant
              <ArrowRight className="size-3.5" />
            </span>
            <span class="font-display group-hover:text-primary text-lg transition-colors">
              {next.data.name}
            </span>
          </a>
        )
      }
    </nav>

    <div class="mt-10 flex justify-center">
      <a
        href="/projects"
        class="border-border hover:border-accent-line hover:bg-card/60 inline-flex items-center gap-2 rounded-full border px-6 py-3.5 text-sm font-semibold transition-colors"
      >
        <ArrowLeft className="size-4" />
        Retour à tous les projets
      </a>
    </div>
  </div>
</Layout>
