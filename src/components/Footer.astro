---
import Logo from '@/components/ui/logo'
import { NAV_LINKS, SITE, SOCIAL_LINKS } from '@/consts'

const year = new Date().getFullYear()

const capabilities = [
  { label: 'Technologies', value: 'Python, OpenAI SDK, Java' },
  { label: 'Expertise', value: 'LLMs, RAG, Agents IA' },
  { label: 'Outils', value: 'Docker, Git, n8n' },
]
---

<footer class="relative z-10 mt-24" aria-label="Pied de page">
  <div class="hairline" aria-hidden="true"></div>

  <div class="shell py-16">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr] lg:gap-16">
      <!-- Identity -->
      <div>
        <a href="/" class="group inline-flex items-center gap-3">
          <Logo />
          <span class="font-display text-lg">{SITE.title}</span>
        </a>

        <p class="text-muted-foreground mt-6 max-w-sm text-sm leading-relaxed">
          Développeur en Intelligence Artificielle spécialisé dans le
          développement de solutions IA innovantes et l'ingénierie logicielle.
          À la pointe de l'IA générative, j'explore les possibilités infinies
          des LLM pour créer des solutions d'entreprise qui façonnent l'avenir.
        </p>

        <dl class="mt-8 space-y-3">
          {
            capabilities.map((item) => (
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <dt class="text-muted-foreground w-24 shrink-0 font-mono text-[0.62rem] tracking-[0.16em] uppercase">
                  {item.label}
                </dt>
                <dd class="text-foreground/90 text-sm">{item.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Navigation -->
      <nav aria-label="Navigation du pied de page">
        <h2 class="kicker">Navigation</h2>
        <ul class="mt-5 space-y-3">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-muted-foreground hover:text-primary link-underline text-sm capitalize transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- Contact -->
      <div>
        <h2 class="kicker">Contact</h2>
        <ul class="mt-5 space-y-3">
          {
            SOCIAL_LINKS.map((social) => (
              <li>
                <a
                  href={social.href}
                  target={social.href.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  class="group flex items-baseline justify-between gap-3 text-sm"
                >
                  <span class="text-muted-foreground group-hover:text-primary link-underline transition-colors">
                    {social.label}
                  </span>
                  <span class="text-muted-foreground/60 truncate font-mono text-[0.65rem]">
                    {social.handle}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <div class="panel mt-8 p-4">
          <p class="text-muted-foreground flex items-center gap-2 text-xs">
            <span class="bg-primary size-1.5 shrink-0 rounded-full"></span>
            {SITE.location}
          </p>
          <p class="text-muted-foreground mt-2 flex items-center gap-2 text-xs">
            <span class="bg-primary size-1.5 shrink-0 rounded-full"></span>
            Réponse sous 24h
          </p>
        </div>
      </div>
    </div>

    <!-- Oversized wordmark -->
    <p
      aria-hidden="true"
      class="font-display text-foreground/[0.06] mt-16 overflow-hidden text-[clamp(2rem,12vw,9.5rem)] leading-none whitespace-nowrap select-none"
    >
      {SITE.title}
    </p>

    <div
      class="border-border mt-8 flex flex-col items-start justify-between gap-4 border-t pt-8 sm:flex-row sm:items-center"
    >
      <p class="text-muted-foreground text-xs">
        © {year} {SITE.author}. Tous droits réservés.
      </p>
      <p class="text-muted-foreground text-xs">
        Conçu et développé avec Astro, React &amp; Tailwind CSS.
      </p>
    </div>
  </div>
</footer>
