---
import { Icon } from 'astro-icon/components'

export interface Crumb {
  href?: string
  label: string
  icon?: string
}

interface Props {
  items: Crumb[]
}

const { items } = Astro.props
---

<nav aria-label="Fil d'Ariane" class="mb-10">
  <ol class="text-muted-foreground flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[0.68rem] tracking-[0.12em] uppercase">
    <li>
      <a href="/" class="hover:text-primary link-underline transition-colors">
        Accueil
      </a>
    </li>
    {
      items.map((item, index) => (
        <>
          <li aria-hidden="true" class="opacity-50">
            /
          </li>
          <li class="flex items-center gap-1.5">
            {item.icon && <Icon name={item.icon} class="size-3.5" />}
            {index === items.length - 1 || !item.href ? (
              <span aria-current="page" class="text-foreground max-w-[16rem] truncate">
                {item.label}
              </span>
            ) : (
              <a
                href={item.href}
                class="hover:text-primary link-underline transition-colors"
              >
                {item.label}
              </a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
