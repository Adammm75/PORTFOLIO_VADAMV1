---
import { cn } from '@/lib/utils'
import type { MarkdownHeading } from 'astro'

interface Props {
  headings: MarkdownHeading[]
  /** Page title, used to drop an article heading that merely repeats it. */
  pageTitle?: string
}

const { headings, pageTitle } = Astro.props

const indent: Record<number, string> = {
  3: 'pl-4',
  4: 'pl-8',
  5: 'pl-12',
  6: 'pl-16',
}

/** Markdown headings arrive HTML-escaped and often carry emoji + punctuation. */
function cleanHeading(text: string): string {
  return text
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&#39;|&apos;/g, "'")
    .replace(/&nbsp;/g, ' ')
    .replace(/<[^>]+>/g, '')
    .trim()
}

function normalise(value: string): string {
  return cleanHeading(value)
    .toLowerCase()
    .replace(/[^\p{L}\p{N}]+/gu, ' ')
    .trim()
}

// Markdown headings are demoted one level (see rehype-shift-headings), so the
// article's own sections sit at h2–h5 under the page's single h1.
let visible = headings.filter(
  (heading) => heading.depth >= 2 && heading.depth <= 5,
)

// Several articles open on a heading that restates the project name; the page
// already shows it as the <h1>, so it would just be a duplicate first entry.
const first = visible[0]
if (pageTitle && first && first.depth === 2) {
  const a = normalise(first.text)
  const b = normalise(pageTitle)
  if (a && b && (a.includes(b) || b.includes(a))) visible = visible.slice(1)
}
---

{
  visible.length > 0 && (
    <nav aria-label="Sommaire" class="toc" data-toc>
      <p class="kicker mb-4">Sommaire</p>
      <ul class="border-border flex list-none flex-col border-l">
        {visible.map((heading) => (
          <li>
            <a
              href={`#${heading.slug}`}
              data-toc-link={heading.slug}
              class={cn(
                'text-muted-foreground hover:text-foreground -ml-px block border-l border-transparent py-1.5 pl-4 text-sm transition-colors duration-200',
                indent[heading.depth],
              )}
            >
              {cleanHeading(heading.text)}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .toc a[data-active='true'] {
    color: var(--foreground);
    border-left-color: var(--primary);
  }
</style>

<script>
  // Highlights the heading currently in view. Runs immediately — the previous
  // version only listened for `astro:page-load`, an event this site never fires.
  function setupToc() {
    const nav = document.querySelector<HTMLElement>('[data-toc]')
    if (!nav) return

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]'),
    )
    if (headings.length === 0) return

    const links = new Map<string, HTMLAnchorElement>()
    nav.querySelectorAll<HTMLAnchorElement>('[data-toc-link]').forEach((link) => {
      links.set(link.dataset.tocLink ?? '', link)
    })

    let active: HTMLAnchorElement | null = null

    const setActive = (id: string) => {
      const link = links.get(id)
      if (!link || link === active) return
      active?.removeAttribute('data-active')
      link.setAttribute('data-active', 'true')
      active = link
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
        if (visible?.target.id) setActive(visible.target.id)
      },
      { rootMargin: '-15% 0px -70% 0px', threshold: 0 },
    )

    headings.forEach((heading) => observer.observe(heading))
  }

  setupToc()
</script>
